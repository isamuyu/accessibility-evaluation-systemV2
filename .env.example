# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accessibility

# 安全密钥（生产环境请修改）
SECRET_KEY=your-secret-key-change-in-production

# 文件上传配置
UPLOAD_DIR=./uploads

# 标准版本
DEFAULT_STANDARD_VERSION=2022
# 认证配置（生产环境设为 true，所有业务接口需要 JWT）
AUTH_REQUIRED=true

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
